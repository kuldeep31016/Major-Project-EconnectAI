# Copy to .env and edit. Never commit .env.
# Where datasets live (external drive / Colab Drive mount / local). Nothing else is hard-coded.
DATA_ROOT=./data
# Class-probability threshold for the binary habitat map (paper: 0.5, uncalibrated design value)
SEGMENTATION_THRESHOLD=0.5
# Any configs/*.yaml leaf can be overridden: ECO_<SECTION>__<KEY>
# ECO_GRAPH__TAU_KM=5.0
# ECO_GRAPH__K_NEIGHBORS=3
# Optional: where pipeline runs are written (default ./outputs)
# ECO_OUTPUTS_DIR=./outputs
# Frontend origin(s) allowed to call the API
ECO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex of extra allowed origins (e.g. every Vercel preview): ECO_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- platform (backend/db.py, backend/auth.py) ---
# ECO_DATABASE_URL=sqlite:///./outputs/ecoconnect.db     # default; PostgreSQL: postgresql+psycopg://user:pass@host/db
# ECO_JWT_SECRET=change-me-to-a-long-random-string       # REQUIRED in any shared deployment (ephemeral if unset)
# ECO_ACCESS_MINUTES=60                                 # access-token lifetime (refresh tokens rotate)
# ECO_REFRESH_DAYS=14
# ECO_DEMO_PASSWORD=demo1234                              # password for the seeded demo accounts (admin, senior, range, field, gis, analyst)

# --- platform: storage + jobs (backend/storage.py, backend/jobs.py) ---
# ECO_STORAGE=local                 # or s3 (any S3-compatible bucket; pip install boto3)
# ECO_S3_BUCKET=ecoconnect-artifacts
# ECO_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# ECO_S3_PREFIX=dev
# ECO_INLINE_WORKER=1               # run jobs in the API process (dev); 0 when a separate `python -m backend.worker` runs
# ECO_JOB_TIMEOUT_S=7200            # per pipeline step
# ECO_JOB_STALE_MIN=30              # RUNNING jobs without heartbeat for this long are marked FAILED

# --- EcoConnectAI Assistant (RAG; docs/GENAI.md) ---
# ANTHROPIC_API_KEY=...             # server-side only; enables the LLM tier for signed-in users
# ECO_ASSISTANT_MODEL=claude-opus-5
# LLM_ENABLED=1                     # 0 = structured + retrieval answers only (no LLM calls, no cost)
# LLM_PROVIDER=anthropic            # or none
# MAX_LLM_CALLS_PER_SESSION=20      # per browser session per 24 h
# ECO_ASSISTANT_PER_HOUR=30         # per user per hour
# ANTHROPIC_WORKSPACE_ID=           # only when the key is scoped to a workspace (sent as a header)
# LLM_MODEL_FAST=claude-haiku-4-5   # chat / knowledge / follow-up / casual (~$0.0035 per answer)
# LLM_MODEL=claude-haiku-4-5
# LLM_MODEL_STRONG=claude-opus-5-5  # analytical / multi-step "why / compare" (~$0.026 per answer)
# LLM_FALLBACK_MODEL=claude-sonnet-5-5
# LLM_EFFORT_FAST=low               # reasoning effort per route
# LLM_EFFORT=low
# LLM_EFFORT_STRONG=medium
# LLM_SERVER_FALLBACK=1             # let the API fail over on overload (beta header)
# LLM_TIMEOUT_S=60                 # one request
# LLM_DEADLINE_S=150               # whole answer incl. retries + fallback; then the extractive answer is used
# LLM_MAX_RETRIES=2
# LLM_PRICING_JSON=                 # optional price override, USD per 1M tokens
# MAX_OUTPUT_TOKENS=4000            # LLM output cap (includes thinking)
# RAG_MAX_CONTEXT_TOKENS=2500       # context budget sent to the LLM
# RAG_CACHE_TTL=604800              # seconds a cached answer stays valid
# --- RAG retrieval / ingestion (docs/rag/SETUP.md) ---
# EMBEDDING_PROVIDER=fastembed      # fastembed | hashing (tests) | none (lexical only, saves ~200 MB RAM)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=outputs/models_cache/fastembed
# EMBEDDING_BATCH_SIZE=1             # >1 multiplies ingest peak memory (64 -> 2.4 GB); keep 1 on 512 MB hosts
# VECTOR_STORE=auto                 # auto (pgvector when present) | pgvector | memory
# RERANKER_PROVIDER=heuristic       # heuristic | cross-encoder | none
# RAG_RETRIEVAL_MODE=hybrid         # hybrid | bm25 | vector (ablation)
# RAG_VECTOR_TOP_K=30               # alias: DENSE_TOP_K
# RAG_LEXICAL_TOP_K=30              # alias: LEXICAL_TOP_K
# RAG_FUSED_TOP_K=20                # alias: FUSED_TOP_K
# RAG_RRF_K=20                      # reciprocal rank fusion constant (tuned; docs/rag/RETRIEVAL.md)
# RAG_RRF_LEXICAL_WEIGHT=1.0
# RAG_RRF_VECTOR_WEIGHT=1.5
# RAG_MAX_TOOL_CALLS=4              # cap on sub-queries for a decomposed question
# RAG_RERANK_TOP_K=6
# RAG_MIN_CONFIDENCE=0.35
# RAG_HISTORY_TURNS=6
# CHUNK_SIZE=350
# CHUNK_OVERLAP=40
# MIN_CHUNK_SIZE=25
# MAX_CHUNK_SIZE=700
# RAG_INGEST_ON_START=1
# ECO_ANON_ASK_PER_HOUR=20          # public-demo questions per client per hour
# ECO_COMPUTE_PER_10MIN=120         # public what-if/scenario/reanalyse calls per client per 10 min

# Needed only when the API key is not scoped to a workspace (the API then answers 400 asking for it).
# Claude Console → Settings → Workspaces → copy the workspace ID (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=

# --- Near-real-time satellite layer (docs/satellite/COPERNICUS_INTEGRATION.md) ---
# Catalogue search (latest observation, history) uses the PUBLIC Copernicus OData API and needs nothing.
# Image retrieval (Analyze latest scene) needs a Copernicus Data Space OAuth client - server-side only, never NEXT_PUBLIC_*.
# SATELLITE_PROVIDER=planetary          # planetary (default): Microsoft Planetary Computer sentinel-1-rtc, no account,
#                                       #   the exact product the model was trained on; copernicus: CDSE GRD (needs the
#                                       #   OAuth client below; GRD is available ~3 h after a pass instead of ~1 day)
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=
# COPERNICUS_TIMEOUT_S=120              # per request (connect timeout: COPERNICUS_CONNECT_TIMEOUT_S=15)
# COPERNICUS_MAX_RETRIES=2              # 429 honours Retry-After (capped 30 s); 5xx/timeouts back off
# SATELLITE_SEARCH_DAYS=60              # catalogue window
# SATELLITE_MIN_AOI_COVERAGE=0.9        # a product must cover >= 90 % of the study-area bbox to be analysed
# SATELLITE_CATALOGUE_TTL_S=600         # catalogue answers are cached this long per study area
# Inference reuses scripts/predict.py and the trained checkpoint; the API image has no torch, so point these at a
# machine/venv that has them (requirements.txt):
# SATELLITE_MODEL_EXPERIMENT=           # default: first with a checkpoint of multi_E1_s1_b0_dev_r3 (leakage-free split), _r2, multi_E1_s1_b0_dev
# SATELLITE_MODEL_CHECKPOINT=           # default outputs/segmentation/<experiment>/best_model.pth
# SATELLITE_INFERENCE_PYTHON=           # a python with torch + segmentation-models-pytorch (default: the API's own)
# SATELLITE_INFERENCE_TIMEOUT_S=3600
